# SemanticGraph Cloud - Environment Configuration Example

# LLM Provider Configuration (T-215)
# GEMINI_API_KEY is read only from environment. Never commit real keys.
# GEMINI_TIER: "free" (default, dev/eval only) or "paid" (required for customer-facing profiles)
GEMINI_API_KEY=
GEMINI_TIER=free

# Postgres & Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/semanticgraph
SEMANTICGRAPH_ADAPTERS=inmemory
