# SemanticGraph Cloud - Environment Configuration Example

# LLM Provider Configuration (T-215, T-217)
# When GEMINI_API_KEY is set, Container.postgres() constructs a real GeminiLLMGateway.
# If no provider API key is set, Container falls back to DeterministicLLMGateway.
# GEMINI_API_KEY is read only from environment. Never commit real keys.
# GEMINI_TIER: "free" (default, dev/eval only) or "paid" (required for customer-facing profiles like postgres)
# GEMINI_MODEL_ID: optional, defaults to "gemini-2.5-flash"
GEMINI_API_KEY=
GEMINI_TIER=paid
GEMINI_MODEL_ID=gemini-2.5-flash

# Postgres & Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/semanticgraph
SEMANTICGRAPH_ADAPTERS=inmemory
